    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Brainfuck.Jinx\Brainfuck.Jinx.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
